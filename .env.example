# Application
APP_ENV=production

# Database Configuration
DB_HOST=localhost
DB_NAME=rsywx
DB_USER=root
DB_PASSWORD=your_password
DB_CHARSET=utf8mb4

# API Configuration
API_KEY=your-secret-api-key-here
API_VERSION=v1

# List Configuration
LIST_PER_PAGE=20

# Public assets / outbound services
COVERS_BASE_URL=https://api.rsywx.com/covers
QWEATHER_API_KEY=your-qweather-api-key-here
QWEATHER_BASE_URL=https://ne5rk4nwr6.re.qweatherapi.com/v7

# Visit tracking
# Record a visit on GET /books/{id} by default; override per request with
# ?visit=false (e.g. for prefetches). Set false to record only when asked.
RECORD_VISITS=true
# Optional IP geolocation for visit records (disable to skip the external call).
GEOLOCATION_ENABLED=true
GEOLOCATION_API_URL=http://ip-api.com/json

# Cache directory (empty = <project>/cache)
CACHE_DIR=

# WordPress (blogs endpoints)
WP_DB_HOST=localhost
WP_DB_NAME=wordpress
WP_DB_USER=wp_user
WP_DB_PASSWORD=wp_password
WP_DB_PREFIX=wp_
WP_BLOG_URL=https://blog.rsywx.net
